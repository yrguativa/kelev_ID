---
const { lang = 'es', puppies = [] } = Astro.props;
import { t } from '../i18n/utils.js';

function statusLabel(status) {
  const map = {
    nuevo: t(lang, 'puppies.tag_new'),
    disponible: t(lang, 'puppies.tag_available'),
    reservado: 'Reservado',
    destacado: 'Destacado',
  };
  return map[status?.toLowerCase()] || status;
}

function statusClass(status) {
  const map = {
    nuevo: 'bg-sprout-lime text-deep-navy',
    disponible: 'bg-white/90 backdrop-blur-sm text-deep-navy border border-surface-container',
    reservado: 'bg-amber-100 text-amber-800 backdrop-blur-sm',
    destacado: 'bg-moss-green text-surface-cream',
  };
  return map[status?.toLowerCase()] || 'bg-white/90 backdrop-blur-sm text-deep-navy border border-surface-container';
}
---

<section class="max-w-7xl mx-auto px-[20px] py-8" id="puppies">
  <div class="text-center mb-12">
    <h3 class="font-headline-lg text-deep-navy">{t(lang, 'puppies.title')}</h3>
    <p class="font-body-md text-on-surface-variant">{t(lang, 'puppies.subtitle')}</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[16px]">
    {puppies.slice(0, 6).map((pup) => {
      const href = lang === 'en' ? `/en/puppy/${pup.id}` : `/puppy/${pup.id}`;
      return (
        <a href={href} class="group no-underline">
          <div class="relative aspect-[3/4] rounded-[32px] overflow-hidden mb-4">
            <img
              src={pup.profilePhotoUrl}
              alt={pup.fullName || pup.breed}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute top-4 left-4 px-3 py-1 rounded-full font-label-sm text-xs tracking-wider uppercase {statusClass(pup.status)}">
              {statusLabel(pup.status)}
            </div>
          </div>
          <div class="px-2">
            <h4 class="font-headline-md text-deep-navy">{pup.fullName || pup.breed}</h4>
            <div class="flex justify-between items-center mt-1">
              <p class="text-on-surface-variant font-label-md italic">{t(lang, 'puppies.adoption')}</p>
              <span class="material-symbols-outlined text-moss-green opacity-0 group-hover:opacity-100 transition-opacity">arrow_circle_right</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
