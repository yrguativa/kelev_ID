---
const { lang = 'es', puppies = [] } = Astro.props;
import { t } from '../i18n/utils.js';

function statusLabel(status) {
  const map = {
    nuevo: t(lang, 'puppies.tag_new'),
    disponible: t(lang, 'puppies.tag_available'),
    reservado: t(lang, 'puppies.status_reservado'),
    destacado: t(lang, 'puppies.status_destacado'),
  };
  return map[status?.toLowerCase()] || status;
}

function statusClass(status) {
  const map = {
    nuevo: 'bg-sprout-lime text-deep-navy',
    disponible: 'bg-white/90 backdrop-blur-sm text-deep-navy border border-surface-container',
    reservado: 'bg-amber-100 text-amber-800 backdrop-blur-sm',
    destacado: 'bg-moss-green text-surface-cream',
  };
  return map[status?.toLowerCase()] || 'bg-white/90 backdrop-blur-sm text-deep-navy border border-surface-container';
}
---

<section class="max-w-7xl mx-auto px-[20px] py-16" id="puppies">
  <div class="text-center mb-12">
    <h3 class="font-headline-lg text-deep-navy">{t(lang, 'puppies.title')}</h3>
    <p class="font-body-md text-on-surface-variant">{t(lang, 'puppies.subtitle')}</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-[16px]">
    {puppies.filter(p => p.status === 'nuevo' || p.status === 'destacado').slice(0, 3).map((pup) => {
      const href = lang === 'en' ? `https://kelevpuppy.com/en/pets/${pup.id}` : `https://kelevpuppy.com/es/pets/${pup.id}`;
      return (
        <a href={href} target="_blank" rel="noopener noreferrer" class="group no-underline">
          <div class="relative aspect-[4/5] rounded-[24px] overflow-hidden">
            <img
              src={pup.profilePhotoUrl}
              alt={pup.fullName || pup.breed}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full font-label-sm text-[11px] tracking-wider uppercase bg-white/60 backdrop-blur-md text-deep-navy">
              {statusLabel(pup.status)}
            </div>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
              <h4 class="font-headline-sm text-white">{pup.fullName || pup.breed}</h4>
              <span class="material-symbols-outlined text-white opacity-0 group-hover:opacity-100 transition-opacity text-xl">arrow_circle_right</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
  <div class="flex justify-center mt-10">
    <a href={lang === 'en' ? 'https://kelevpuppy.com/en/puppies' : 'https://kelevpuppy.com/es/puppies'} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-moss-green text-surface-cream font-label-md rounded-full hover:opacity-90 transition-opacity no-underline">
      {t(lang, 'puppies.view_more')}
      <span class="material-symbols-outlined text-lg">arrow_forward</span>
    </a>
  </div>
</section>
