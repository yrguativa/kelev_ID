---
import { t } from '../i18n/utils.js';
const { lang = 'es' } = Astro.props;
---
<header class="w-full top-0 sticky z-50 bg-surface-cream/80 backdrop-blur-md border-b border-outline-variant/30">
  <nav class="flex justify-between items-center w-full px-[20px] max-w-7xl mx-auto py-4">
    <div class="flex items-center gap-2">
      <span class="text-headline-md font-headline-md font-bold text-moss-green">{t(lang, 'header.title')}</span>
    </div>
    <div class="hidden md:flex items-center gap-[32px]"></div>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-1 text-label-md font-label-md">
        {
          lang === 'es' ? (
            <>
              <span class="text-moss-green font-bold">ES</span>
              <span class="text-outline-variant">/</span>
              <a href="/en/" class="text-on-surface-variant no-underline hover:text-moss-green transition-colors">EN</a>
            </>
          ) : (
            <>
              <a href="/" class="text-on-surface-variant no-underline hover:text-moss-green transition-colors">ES</a>
              <span class="text-outline-variant">/</span>
              <span class="text-moss-green font-bold">EN</span>
            </>
          )
        }
      </div>
      <button class="hidden sm:block text-label-md font-label-md text-moss-green hover:underline decoration-2 underline-offset-4 cursor-pointer bg-transparent border-none">{t(lang, 'header.log_in')}</button>
      <button class="bg-moss-green text-surface-cream px-6 py-2.5 rounded-full text-label-md font-label-md active:scale-95 transition-all shadow-sm cursor-pointer border-none">{t(lang, 'header.get_started')}</button>
    </div>
  </nav>
</header>
