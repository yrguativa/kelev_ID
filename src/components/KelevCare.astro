---
const { lang = 'es' } = Astro.props;
import { t } from '../i18n/utils.js';
---
<section class="max-w-7xl mx-auto px-[20px] py-8 animate-[fade-up_0.6s_ease-out_0.6s_both]">
  <div class="flex items-end justify-between mb-8">
    <div>
      <h3 class="font-headline-lg text-deep-navy">{t(lang, 'kelevcare.title')}</h3>
      <p class="font-body-md text-on-surface-variant max-w-md">{t(lang, 'kelevcare.subtitle')}</p>
    </div>
    <button class="flex items-center gap-2 text-moss-green font-label-md group cursor-pointer bg-transparent border-none">
      {t(lang, 'kelevcare.view_record')}
      <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">arrow_forward</span>
    </button>
  </div>
  <div class="grid md:grid-cols-2 gap-[16px]">
    <div class="bg-white p-6 md:p-8 rounded-3xl elevation-soft flex items-center gap-6 border border-surface-container transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_24px_0_rgba(4,11,40,0.08)]">
      <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-secondary-container flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-primary text-2xl md:text-3xl [font-variation-settings:'FILL'_1]">vaccines</span>
      </div>
      <div class="flex-grow">
        <h4 class="font-headline-md text-[20px] md:text-[24px] text-deep-navy">{t(lang, 'kelevcare.vaccines')}</h4>
        <div class="flex items-center gap-2 mt-1">
          <span class="w-2 h-2 rounded-full bg-moss-green"></span>
          <p class="font-label-md text-moss-green">{t(lang, 'kelevcare.vaccines_status')}</p>
        </div>
      </div>
      <span class="material-symbols-outlined text-outline">chevron_right</span>
    </div>
    <div class="bg-white p-6 md:p-8 rounded-3xl elevation-soft flex items-center gap-6 border border-surface-container transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_24px_0_rgba(4,11,40,0.08)]">
      <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-sprout-lime flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-primary text-2xl md:text-3xl [font-variation-settings:'FILL'_1]">medical_services</span>
      </div>
      <div class="flex-grow">
        <h4 class="font-headline-md text-[20px] md:text-[24px] text-deep-navy">{t(lang, 'kelevcare.vetcheck')}</h4>
        <div class="flex items-center gap-2 mt-1">
          <span class="w-2 h-2 rounded-full bg-moss-green"></span>
          <p class="font-label-md text-moss-green">{t(lang, 'kelevcare.vetcheck_status')}</p>
        </div>
      </div>
      <span class="material-symbols-outlined text-outline">chevron_right</span>
    </div>
  </div>
</section>
