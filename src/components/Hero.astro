---
const { lang = 'es', puppy } = Astro.props;
import { t } from '../i18n/utils.js';

const u = (val) => val || t(lang, 'passport.unknown');

const icons = {
  breed: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12c-1.5 0-3-1.5-3-4s1.5-4 3-4 3 1.5 3 4-1.5 4-3 4Z"/><path d="M14 12c1.5 0 3-1.5 3-4s-1.5-4-3-4-3 1.5-3 4 1.5 4 3 4Z"/><path d="M18 15c-1.5 0-3-1-3-3s1.5-3 3-3 3 1 3 3-1.5 3-3 3Z"/><path d="M6 15c1.5 0 3-1 3-3s-1.5-3-3-3-3 1-3 3 1.5 3 3 3Z"/><path d="M12 20c-2 0-4-1-4-3h8c0 2-2 3-4 3Z"/></svg>',
  gender: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="4"/><path d="m9 13-4 4m0-4 4 4"/><path d="M17 3v8m4-4-4 4-4-4"/></svg>',
  birth: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>',
  color: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="4.5"/><circle cx="6" cy="16" r="3"/><circle cx="18" cy="16" r="2"/><path d="M13.5 6.5 6 16"/><path d="M13.5 6.5 18 16"/></svg>',
  fur: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4c0 2 2 4 4 4s4-2 4-4a4 4 0 0 0-4-4Z"/><path d="M4 11c0 2 2 4 4 4s4-2 4-4-2-4-4-4-4 2-4 4Z"/><path d="M16 11c0 2 2 4 4 4s4-2 4-4-2-4-4-4-4 2-4 4Z"/><path d="M12 14c-2 0-4 2-4 4s2 4 4 4 4-2 4-4-2-4-4-4Z"/></svg>',
  weight: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a3 3 0 0 0-3 3v1H5.5A1.5 1.5 0 0 0 4 8.5v9A1.5 1.5 0 0 0 5.5 19h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 18.5 7H15V6a3 3 0 0 0-3-3Z"/><path d="M9 11h6"/><circle cx="12" cy="14" r="2"/></svg>',
};

function formatDate(dateStr, locale) {
  if (!dateStr) return null;
  const date = new Date(dateStr);
  return date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

function isVideo(url) {
  return url?.match(/\.(mp4|mov|webm)(\?|$)/i);
}
---
<section class="max-w-7xl mx-auto px-[20px] pt-24 pb-8">
  <div class="bg-white squircle elevation-soft overflow-hidden flex flex-col md:flex-row min-h-[500px] animate-[fade-up_0.6s_ease-out]">
    <div class="md:w-5/12 h-[400px] md:h-auto overflow-hidden relative">
      <div class="absolute top-6 left-6 bg-sprout-lime text-deep-navy px-4 py-1 rounded-full font-label-sm uppercase tracking-wider z-10 animate-[pulse-subtle_2s_ease-in-out_infinite]">
        {t(lang, 'passport.badge')}
      </div>
      <img
        src={puppy?.profilePhotoUrl || 'https://lh3.googleusercontent.com/aida/AP1WRLvZjDeQtDgjBLhqz6ZDbOoRNpVQBmLg2-T8wHL0i0s4nqex0GUjxrGO7DhljAcnc0b2_n4MwroG8Nq51lClVTcQCulPCJQTqpYqQcDDpE7tZTCT_JKoFwu2sgqho0KPpkYQP4aLytE0poTuQHho0hqlJvAMEeL7Yf4ywTJ7Tqr9g29kQmD1lUClXJB_poSDKY7QiAOQKSll7NXYqdV9A3UcbWMsDnlBZE7y7SNYVvVrJ3_8yByjrezA-Xnh'}
        alt={puppy?.fullName || 'Rocky'}
        class="w-full h-full object-cover transition-transform duration-[1.5s] hover:scale-105"
      />
    </div>
    <div class="md:w-7/12 p-8 md:p-16 flex flex-col justify-start">
      <div class="flex items-center gap-4 mb-2 animate-[fade-up_0.5s_ease-out_0.2s_both]">
        <span class="w-12 h-[2px] bg-sprout-lime"></span>
        <span class="font-label-md text-moss-green tracking-[0.2em] uppercase">{t(lang, 'passport.label')}</span>
      </div>
      <h2 class="font-display-lg text-[36px] md:text-[64px] leading-tight text-deep-navy mb-6 md:mb-8 animate-[fade-up_0.5s_ease-out_0.3s_both]">{puppy?.fullName || t(lang, 'passport.name')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 md:gap-y-7 gap-x-4 md:gap-x-8">
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.35s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.breed} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.breed_label')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{u(puppy?.breed)}</p>
          </div>
        </div>
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.4s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.gender} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.gender_label')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{u(puppy?.gender)}</p>
          </div>
        </div>
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.45s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.birth} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.birth_label')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{puppy?.birthDate ? formatDate(puppy.birthDate, lang) : u()}</p>
          </div>
        </div>
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.5s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.color} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.color_label')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{u(puppy?.color)}</p>
          </div>
        </div>
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.55s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.fur} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.fur_type')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{u(puppy?.furType)}</p>
          </div>
        </div>
        <div class="flex items-start gap-3" style="animation: fade-up 0.5s ease-out 0.6s both;">
          <span class="shrink-0 mt-0.5 text-moss-green" set:html={icons.weight} />
          <div>
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest">{t(lang, 'passport.weight')}</p>
            <p class="font-headline-md text-primary text-[18px] md:text-[22px]">{puppy?.weight ? `${puppy.weight} ${t(lang, 'puppy_detail.kg')}` : u()}</p>
          </div>
        </div>
      </div>

      {
        puppy?.galleryPhotos?.length > 0 && (
          <div class="mt-6 md:mt-8 pt-6 md:pt-8 border-t border-surface-container animate-[fade-up_0.5s_ease-out_0.65s_both]">
            <p class="font-label-sm text-on-surface-variant uppercase tracking-widest mb-4">{t(lang, 'passport.gallery')}</p>
            <div class="grid grid-cols-3 gap-2 md:gap-3">
              {puppy.galleryPhotos.map((url) => (
                isVideo(url)
                  ? <video src={url} class="w-full aspect-square object-cover rounded-xl" />
                  : <img src={url} alt="" class="w-full aspect-square object-cover rounded-xl transition-transform duration-300 hover:scale-105 hover:shadow-[0_4px_12px_0_rgba(4,11,40,0.1)]" />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>