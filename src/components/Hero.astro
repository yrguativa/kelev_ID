---
const { lang = 'es', puppy } = Astro.props;
import { t } from '../i18n/utils.js';

function formatDate(dateStr, locale) {
  if (!dateStr) return null;
  const date = new Date(dateStr);
  return date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---
<section class="max-w-7xl mx-auto px-[20px] pt-24 pb-8">
  <div class="bg-white squircle elevation-soft overflow-hidden flex flex-col md:flex-row min-h-[500px] animate-[fade-up_0.6s_ease-out]">
    <div class="md:w-5/12 h-[400px] md:h-auto overflow-hidden relative">
      <div class="absolute top-6 left-6 bg-sprout-lime text-deep-navy px-4 py-1 rounded-full font-label-sm uppercase tracking-wider z-10 animate-[pulse-subtle_2s_ease-in-out_infinite]">
        {t(lang, 'passport.badge')}
      </div>
      <img
        src={puppy?.profilePhotoUrl || 'https://lh3.googleusercontent.com/aida/AP1WRLvZjDeQtDgjBLhqz6ZDbOoRNpVQBmLg2-T8wHL0i0s4nqex0GUjxrGO7DhljAcnc0b2_n4MwroG8Nq51lClVTcQCulPCJQTqpYqQcDDpE7tZTCT_JKoFwu2sgqho0KPpkYQP4aLytE0poTuQHho0hqlJvAMEeL7Yf4ywTJ7Tqr9g29kQmD1lUClXJB_poSDKY7QiAOQKSll7NXYqdV9A3UcbWMsDnlBZE7y7SNYVvVrJ3_8yByjrezA-Xnh'}
        alt={puppy?.fullName || 'Rocky'}
        class="w-full h-full object-cover transition-transform duration-[1.5s] hover:scale-105"
      />
    </div>
    <div class="md:w-7/12 p-8 md:p-16 flex flex-col justify-center">
      <div class="flex items-center gap-4 mb-2 animate-[fade-up_0.5s_ease-out_0.2s_both]">
        <span class="w-12 h-[2px] bg-sprout-lime"></span>
        <span class="font-label-md text-moss-green tracking-[0.2em] uppercase">{t(lang, 'passport.label')}</span>
      </div>
      <h2 class="font-display-lg text-[36px] md:text-[64px] leading-tight text-deep-navy mb-6 md:mb-8 animate-[fade-up_0.5s_ease-out_0.3s_both]">{puppy?.fullName || t(lang, 'passport.name')}</h2>
      <div class="grid grid-cols-2 gap-y-6 md:gap-y-8 gap-x-12">
        <div style="animation: fade-up 0.5s ease-out 0.4s both;">
          <p class="font-label-sm text-on-surface-variant uppercase tracking-widest mb-1">{t(lang, 'passport.breed_label')}</p>
          <p class="font-headline-md text-primary text-[20px] md:text-[24px]">{puppy?.breed || t(lang, 'passport.breed')}</p>
        </div>
        <div style="animation: fade-up 0.5s ease-out 0.45s both;">
          <p class="font-label-sm text-on-surface-variant uppercase tracking-widest mb-1">{t(lang, 'passport.gender_label')}</p>
          <p class="font-headline-md text-primary text-[20px] md:text-[24px]">{puppy?.gender || t(lang, 'passport.gender')}</p>
        </div>
        <div style="animation: fade-up 0.5s ease-out 0.5s both;">
          <p class="font-label-sm text-on-surface-variant uppercase tracking-widest mb-1">{t(lang, 'passport.birth_label')}</p>
          <p class="font-headline-md text-primary text-[20px] md:text-[24px]">{puppy ? formatDate(puppy.birthDate, lang) : t(lang, 'passport.birth')}</p>
        </div>
        <div style="animation: fade-up 0.5s ease-out 0.55s both;">
          <p class="font-label-sm text-on-surface-variant uppercase tracking-widest mb-1">{t(lang, 'passport.color_label')}</p>
          <p class="font-headline-md text-primary text-[20px] md:text-[24px]">{puppy?.color || t(lang, 'passport.color')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
