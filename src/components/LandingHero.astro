---
import { t } from '../i18n/utils.js';
const { lang = 'es' } = Astro.props;
---
<section class="relative min-h-[85vh] flex items-center overflow-hidden pt-12">
  <div class="max-w-7xl mx-auto px-[20px] grid grid-cols-1 lg:grid-cols-2 gap-[32px] items-center z-10">
    <div class="space-y-[16px] scroll-reveal-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full" style="background-color: rgba(214, 237, 124, 0.2); border: 1px solid rgba(214, 237, 124, 0.3);">
        <span class="material-symbols-outlined text-[18px] text-moss-green [font-variation-settings:'FILL'_1]">auto_awesome</span>
        <span class="text-label-md font-label-md text-moss-green">{t(lang, 'hero.badge')}</span>
      </div>
      <h1 class="text-display-lg font-display-lg leading-tight text-deep-navy" set:html={t(lang, 'hero.title')}>
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-xl">
        {t(lang, 'hero.subtitle')}
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <button class="bg-moss-green text-surface-cream px-8 py-4 rounded-full text-label-md font-label-md flex items-center gap-2 hover:shadow-lg transition-all active:scale-95 cursor-pointer border-none">
          {t(lang, 'hero.cta_primary')} <span class="material-symbols-outlined">arrow_forward</span>
        </button>
        <button class="bg-surface-container-high text-on-surface px-8 py-4 rounded-full text-label-md font-label-md flex items-center gap-2 border border-outline-variant/30 hover:bg-surface-container-highest transition-all active:scale-95 cursor-pointer">
          <span class="material-symbols-outlined [font-variation-settings:'FILL'_1]">play_circle</span>
          {t(lang, 'hero.cta_secondary')}
        </button>
      </div>
    </div>
    <div class="relative flex justify-center lg:justify-end scroll-reveal-right">
      <div class="relative w-full max-w-md aspect-[4/5] overflow-hidden shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-700" style="border-radius: 40px;">
        <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/AP1WRLtZF_j0Vj9s_oyoWQgb2ulixeLO8tAfPWztHvr6BsVbBsoQytM7YUoRT3ZoWJRKm0XK4Vm9ebVgSo0I-_7EUwiY22BE9ONAP_Ffb5u5a_74bqjtYb1xEQsIuRHH7em10VrXTZ9pw53zme04wU1ueDFUAvxacfkwQohKscgeB1CckRVntu805mXB_pXTePJoJPDEjKeWavjSX9LaJFqh-kb-d1Z6NRBzblG6pXj_EjNQaz5JEmTFcx5kkv6y" alt="Puppies" loading="lazy" />
      </div>
      <div class="absolute -bottom-6 -left-6 bg-white p-6 shadow-xl max-w-[200px] hidden sm:block border border-outline-variant/10" style="border-radius: 40px;">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-sprout-lime rounded-full flex items-center justify-center">
            <span class="material-symbols-outlined text-moss-green">verified</span>
          </div>
          <span class="text-label-md font-label-md">{t(lang, 'hero.secure_title')}</span>
        </div>
        <p class="text-[10px] text-on-surface-variant leading-tight">{t(lang, 'hero.secure_text')}</p>
      </div>
    </div>
  </div>
  <div class="absolute inset-0 z-0 opacity-40 pointer-events-none">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full" style="background: var(--color-sprout-lime); opacity: 0.3; filter: blur(120px);"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full" style="background: var(--color-moss-green); opacity: 0.1; filter: blur(100px);"></div>
  </div>
</section>
