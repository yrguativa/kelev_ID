---
const { lang = 'es' } = Astro.props;
import { t } from '../i18n/utils.js';
---
<section class="max-w-7xl mx-auto px-[20px] py-8 scroll-reveal">
  <div class="bg-deep-navy rounded-[32px] md:rounded-[40px] p-8 md:p-16 text-white overflow-hidden relative transition-all duration-500 hover:shadow-[0_16px_48px_0_rgba(4,11,40,0.2)]">
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(circle_at_top_right,var(--color-sprout-lime),transparent)]"></div>
    <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-8 md:gap-12">
      <div class="max-w-xl text-center md:text-left">
        <h3 class="font-display-lg text-[32px] md:text-[40px] text-sprout-lime mb-4">{t(lang, 'contact.title')}</h3>
        <p class="font-body-lg text-surface-variant/80 mb-8 md:mb-10">{t(lang, 'contact.text')}</p>
        <div class="space-y-6">
          <div class="flex items-start justify-center md:justify-start gap-4 transition-transform duration-300 hover:translate-x-1">
            <span class="material-symbols-outlined text-sprout-lime">location_on</span>
            <div>
              <p class="font-label-md text-white">{t(lang, 'contact.location')}</p>
              <p class="text-sm text-surface-variant/60">{t(lang, 'contact.address')}</p>
            </div>
          </div>
          <div class="flex items-start justify-center md:justify-start gap-4 transition-transform duration-300 hover:translate-x-1">
            <span class="material-symbols-outlined text-sprout-lime">schedule</span>
            <div>
              <p class="font-label-md text-white">{t(lang, 'contact.schedule')}</p>
              <p class="text-sm text-surface-variant/60">{t(lang, 'contact.emergencies')}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-4 w-full md:w-auto min-w-[280px]">
        <button class="button-squish bg-sprout-lime text-deep-navy font-bold py-4 px-8 rounded-2xl flex items-center justify-center gap-3 border-none cursor-pointer transition-all duration-300 hover:scale-[1.02] text-base">
          <span class="material-symbols-outlined">call</span>
          {t(lang, 'contact.call')}
        </button>
        <button class="button-squish bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold py-4 px-8 rounded-2xl flex items-center justify-center gap-3 cursor-pointer transition-all duration-300 hover:scale-[1.02] text-base">
          <span class="material-symbols-outlined">chat</span>
          {t(lang, 'contact.whatsapp')}
        </button>
      </div>
    </div>
  </div>
</section>
