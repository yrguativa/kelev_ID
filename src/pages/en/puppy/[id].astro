---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import PuppyDetail from '../../../components/PuppyDetail.astro';
import Footer from '../../../components/Footer.astro';
import { getAllPuppies } from '../../../lib/puppies.js';

export async function getStaticPaths() {
  const puppies = await getAllPuppies();
  return puppies.filter(pup => pup.id !== '6a6018299cbaf604fac05189' && pup.id !== '6a600f769096a0838fbc83bc').map(pup => ({
    params: { id: pup.id },
    props: { puppy: pup },
  }));
}

const { puppy } = Astro.props;
const lang = 'en';
const title = puppy?.fullName || puppy?.breed || 'Puppy Detail';
---

<BaseLayout title={title}>
  <Header lang={lang} slot="header" />
  <PuppyDetail puppy={puppy} lang={lang} />
  <Footer lang={lang} slot="footer" />
</BaseLayout>
