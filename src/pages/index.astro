---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import LandingHero from '../components/LandingHero.astro';
import PillarsSection from '../components/PillarsSection.astro';
import SecuritySection from '../components/SecuritySection.astro';
import EcosystemSection from '../components/EcosystemSection.astro';
import AvailablePuppies from '../components/AvailablePuppies.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import { getAllPuppies } from '../lib/puppies.js';

const lang = Astro.currentLocale || 'es';
const title = lang === 'en' ? 'Home' : 'Inicio';
const featuredCanines = await getAllPuppies();
---

<BaseLayout title={title}>
  <Header lang={lang} slot="header" />
  <LandingHero lang={lang} />
  <PillarsSection lang={lang} />
  <SecuritySection lang={lang} />
  <EcosystemSection lang={lang} />
  <CtaSection lang={lang} />
  <AvailablePuppies lang={lang} puppies={featuredCanines} />
  <Footer lang={lang} slot="footer" />
</BaseLayout>
