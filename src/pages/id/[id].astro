---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PassportHeader from '../../components/PassportHeader.astro';
import HeroSection from '../../components/Hero.astro';
import KelevCare from '../../components/KelevCare.astro';
import Contact from '../../components/Contact.astro';
import PassportFooter from '../../components/PassportFooter.astro';
import { getAllPuppies } from '../../lib/puppies.js';

export async function getStaticPaths() {
  const puppies = await getAllPuppies();
  return puppies.map(pup => ({
    params: { id: pup.id },
    props: { puppy: pup },
  }));
}

const { puppy } = Astro.props;
const lang = Astro.currentLocale || 'es';
const title = puppy?.fullName || 'Digital Passport';
---

<BaseLayout title={`${title} - Digital Passport`}>
  <PassportHeader lang={lang} slot="header" />
  <HeroSection lang={lang} puppy={puppy} />
  <KelevCare lang={lang} />
  <Contact lang={lang} />
  <PassportFooter lang={lang} slot="footer" />
</BaseLayout>